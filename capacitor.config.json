{
  "appId": "com.outfitted.app",
  "appName": "Outfitted",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#f6f6f3",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#f6f6f3"
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
